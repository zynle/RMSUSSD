APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# --- USSD state machine (sparors/laravel-ussd) ---
USSD_STORE=database
USSD_TTL=300

# --- USSD gateway (inbound) ---
USSD_GATEWAY_API_ID=1234
USSD_GATEWAY_API_KEY=1234
USSD_SHORTCODES=885*228
USSD_DISPLAY_SHORTCODE=885*228
USSD_SESSION_TTL=300
USSD_RESUME_TTL=180

# --- ZynlePay payment gateway --- (set ZYNLEPAY_MOCK=false and fill real
# credentials below to go live; see docs/README for details)
ZYNLEPAY_MOCK=true
ZYNLEPAY_MOCK_OUTCOME=success
ZYNLEPAY_BASE_URL=https://payments.zynlepay.com/zynlepay/jsonapi/
ZYNLEPAY_STATUS_URL=https://payments.zynlepay.com/zynlepay/paymentstatus
ZYNLEPAY_MERCHANT_ID=CHANGE_ME_MERCHANT_ID
ZYNLEPAY_API_ID=CHANGE_ME_API_ID
ZYNLEPAY_API_KEY=CHANGE_ME_API_KEY
ZYNLEPAY_SERVICE_ID=CHANGE_ME_SERVICE_ID
ZYNLEPAY_CHANNEL=momo
ZYNLEPAY_STATUS_API_ID=CHANGE_ME_STATUS_API_ID
ZYNLEPAY_STATUS_API_KEY=CHANGE_ME_STATUS_API_KEY
ZYNLEPAY_MAX_RETRIES=6
ZYNLEPAY_RETRY_INTERVAL=2

# --- SMS gateway --- (set SMS_MOCK=false and fill real credentials to go live)
SMS_MOCK=true
SMS_BASE_URL=https://usersms.zynle.com/api/v2/SendSMS
SMS_SENDER_ID=CHANGE_ME_SENDER
SMS_API_KEY=CHANGE_ME_SMS_API_KEY
SMS_CLIENT_ID=CHANGE_ME_CLIENT_ID

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
